{
  "name": "spaniakos/simple-php-db-wrapper",
  "description": "A small, safe PDO database wrapper for MySQL",
  "type": "library",
  "require": {
    "php": ">=7.4",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "monolog/monolog": "^2.9 || ^3.0",
    "psr/log": "^1.1 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.4",
    "friendsofphp/php-cs-fixer": "^3.35",
    "phpstan/phpstan": "^1.10 || ^2.0"
  },
  "license": "GPL-3.0",
  "autoload": {
    "psr-4": {
      "Spaniakos\\": "src/Spaniakos"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Spaniakos\\Tests\\": "src/Tests"
    }
  },
  "authors": [
    {
      "name": "Georgios Spanos (Spaniakos)",
      "email": "spaniakos@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse src/Spaniakos --no-progress",
    "format:check": "php-cs-fixer fix --dry-run --diff"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "7.4.0"
    },
    "allow-plugins": {}
  }
}
